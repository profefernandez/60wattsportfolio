    "@radix-ui/react-slot": "^1.1.0",
    "@sentry/nextjs": "^10.63.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "next": "^15.5.20",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@mdx-js/loader": "^3.1.0",
